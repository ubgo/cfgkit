# The application's committed defaults. Comments and blank lines are part of
# the file's contract with the humans who edit it.

APP_NAME=checkout
PORT=8080

# Values may reference earlier ones. The reference is resolved by the .env
# parser, not by the shell, so it works identically in every environment.
BASE_URL=http://localhost:${PORT}

# Quoting is preserved as written; a quoted value may span lines.
GREETING="hello, world"

DATABASE_URL=postgres://localhost/checkout_dev
DATABASE_PASSWORD=dev-only-password
